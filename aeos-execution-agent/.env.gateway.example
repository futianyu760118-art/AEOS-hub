# 中控平台网关配置示例（复制为 .env 使用；不要提交真实密钥）
# 单 Agent 兼容模式：一条 WS、两个能力、一个网关身份。

# Hub 控制通道
EXECUTION_WS_URL=wss://aeos-hub.example.com/execution-agent

# 每系统身份（两项必须同时填）
EXECUTION_SYSTEM_ID=control-platform
EXECUTION_SYSTEM_TOKEN=__REPLACE_WITH_SYSTEM_TOKEN__

# 网关身份：与直连执行体（runtime-control-platform-query/reasoning）区分开
EXECUTION_AGENT_ID=gateway-control-platform
EXECUTION_AGENT_NAME=公司中控平台网关
EXECUTION_SOURCE_SYSTEM=control-platform
EXECUTION_AGENT_VERSION=1.0.0
EXECUTION_GATEWAY_VERSION=1.0.0
EXECUTION_PROTOCOL_VERSION=1.0

# 目标系统查询接口（只读）
TARGET_QUERY_BASE_URL=https://spc.example.com/api/v1
TARGET_QUERY_APP_KEY=__REPLACE_WITH_READONLY_APP_KEY__
TARGET_QUERY_APP_SECRET=__REPLACE_WITH_READONLY_APP_SECRET__

# 目标系统推理智能体（契约确认后填写；留空则 reasoning 能力返回「未接通」）
TARGET_REASONING_URL=
TARGET_REASONING_AGENT_ID=
TARGET_REASONING_TOKEN=
