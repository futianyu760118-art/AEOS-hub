# Docker host binding. Keep 127.0.0.1 for local verification.
# For a trusted LAN, set 0.0.0.0 and restrict the host firewall to your office subnet.
AEOS_BIND_ADDRESS=127.0.0.1
AEOS_PORT=8787

# Browser login: use the same account/password as M03. Keep .env local and uncommitted.
AEOS_LOGIN_USERNAME=admin
AEOS_LOGIN_PASSWORD=

# Optional first-start bootstrap for the existing DeepSeek provider.
# Do not commit the copied .env file.
DEEPSEEK_API_KEY=

# Authentication mode: the root Hub Compose stays in local-dev mode by default.
# Do not add M01 issuer/client secrets to this versioned example. For the isolated
# Keycloak + PostgreSQL development/test stack and the complete Hub M01 contract,
# copy deploy/m01/.env.example to deploy/m01/.env and follow docs/auth/m01-integration.md.
# The root docker-compose.yml intentionally does not pass M01_* variables; a real
# M01 Hub deployment must inject them securely in its own deployment definition.
# When enabling M01 there, AEOS_M01_ALLOWED_ROLES is mandatory. It is a
# comma-separated Hub admission list, for example: manager,analyst. Do not
# treat it as per-action authorization; Hub Guard remains the fine-grained layer.
# M01 Agent registration bridge. Keep the secret only in this ignored .env.
M01_AGENT_REGISTRATION_URL=http://host.docker.internal:3101/integrations/m13
M01_AGENT_REGISTRATION_SECRET=
M01_AGENT_TENANT_ID=TENANT_A
M01_AGENT_OWNER_PERSON_ID=P_OWNER
# Local DEMO only: set true when the M01 endpoint is HTTP. Production must use HTTPS.
M01_AGENT_REGISTRATION_ALLOW_INSECURE_HTTP=false
