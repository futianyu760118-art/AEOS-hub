# Docker host binding. Keep 127.0.0.1 for local verification.
# For a trusted LAN, set 0.0.0.0 and restrict the host firewall to your office subnet.
AEOS_BIND_ADDRESS=127.0.0.1
AEOS_PORT=8787

# Browser login: change the username and set a strong password locally. Do not commit .env.
AEOS_LOGIN_USERNAME=demo
AEOS_LOGIN_PASSWORD=

# Optional first-start bootstrap for the existing DeepSeek provider.
# Do not commit the copied .env file.
DEEPSEEK_API_KEY=

# Optional M02/EDP evidence delivery. When unset, Evidence remains in the
# local pilot outbox (data/m02-outbox.jsonl).
# M02_ENDPOINT=https://m02.example/events
# M02_TOKEN=

# M13 Agent Workforce session API (used by M05 CRM and other systems to call
# the hub agents agent-main / agent-quality / agent-sales over
# /poms/v1/agents/*). Set a strong shared secret; requests authenticate with
# `X-API-Key: <secret>` or `Authorization: Bearer <secret>`.
# When unset, the endpoint returns 503 NOT_CONFIGURED.
# M13_AGENT_CHAT_API_KEY=

# Authentication mode: Hub now supports M01 only. The root Compose example is
# retained for local reference but must not be used as a local-dev deployment;
# a real Hub instance must inject AEOS_AUTH_MODE=m01, M01_* settings and
# AEOS_M01_ALLOWED_ROLES securely in its deployment definition.
# For the isolated Keycloak + PostgreSQL development/test stack and the complete
# Hub M01 contract, copy deploy/m01/.env.example to deploy/m01/.env and follow
# docs/auth/m01-local-startup.md and docs/auth/m01-integration.md.
# AEOS_M01_ALLOWED_ROLES is a comma-separated Hub admission list, for example:
# manager,supervisor,operator. It is not per-action authorization; Hub Guard
# remains the fine-grained layer.
