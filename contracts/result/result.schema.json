{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEOS Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_id", "result_type", "tenant_id", "object_ref", "owner", "created_by", "status", "source_system", "correlation_id", "version", "evidence_refs", "summary", "created_at", "verified_by", "verified_at", "verification_note"],
  "properties": {
    "result_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "result_type": { "type": "string", "minLength": 1, "maxLength": 200 },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "object_ref": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "owner": { "type": "string", "minLength": 1, "maxLength": 200 },
    "created_by": { "type": "string", "minLength": 1, "maxLength": 200 },
    "status": { "enum": ["PENDING", "VERIFIED", "REJECTED"] },
    "source_system": { "type": "string", "minLength": 1, "maxLength": 200 },
    "correlation_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "version": { "type": "string", "minLength": 1, "maxLength": 40 },
    "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 2048 }, "maxItems": 200, "uniqueItems": true },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "created_at": { "type": "string", "format": "date-time" },
    "verified_by": { "type": ["string", "null"], "maxLength": 200 },
    "verified_at": { "type": ["string", "null"], "format": "date-time" },
    "verification_note": { "type": ["string", "null"], "maxLength": 4000 }
  }
}
