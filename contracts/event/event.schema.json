{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEOS Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "tenant_id", "object_ref", "source_system", "correlation_id", "version", "occurred_at", "evidence_refs"],
  "properties": {
    "event_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "event_type": { "type": "string", "minLength": 1, "maxLength": 200 },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "object_ref": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "source_system": { "type": "string", "minLength": 1, "maxLength": 200 },
    "correlation_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "version": { "type": "string", "minLength": 1, "maxLength": 40 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 2048 }, "maxItems": 200, "uniqueItems": true },
    "payload": {}
  }
}
