{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEOS Evidence Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "occurred_at",
    "tenant_id",
    "object_ref",
    "source_system",
    "correlation_id",
    "version",
    "kind",
    "evidence_refs",
    "payload_hash"
  ],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "object_ref": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "source_system": { "type": "string", "minLength": 1, "maxLength": 200 },
    "correlation_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "version": { "type": "string", "minLength": 1, "maxLength": 40 },
    "kind": { "type": "string", "minLength": 1, "maxLength": 100 },
    "method": { "type": "string", "maxLength": 500 },
    "thread_id": { "type": "string", "maxLength": 200 },
    "turn_id": { "type": "string", "maxLength": 200 },
    "item_type": { "type": "string", "maxLength": 100 },
    "summary": { "type": "string", "maxLength": 4000 },
    "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 2048 }, "maxItems": 200, "uniqueItems": true },
    "payload_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "payload": {}
  }
}
