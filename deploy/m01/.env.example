# Copy this file to deploy/m01/.env before starting the local M01 identity stack.
# The sentinel values below intentionally pass `docker compose config` but make
# `docker compose up` fail before PostgreSQL or Keycloak starts. Replace each
# sentinel in the copied .env file; never commit that file.

# Default local-only topology. For a trusted private LAN, use the same fixed
# IPv4 in M01_LISTEN_ADDRESS and both external hostname variables, then run
# scripts/configure-m01-lan.ps1. Never publish PostgreSQL or Hub port 8790.
M01_LISTEN_ADDRESS=127.0.0.1
M01_KEYCLOAK_HTTPS_PORT=8443
M01_KEYCLOAK_EXTERNAL_HOSTNAME=localhost
M01_HUB_HTTPS_PORT=8444
M01_HUB_EXTERNAL_HOSTNAME=localhost

# Execution-plane pre-shared token. Generate it with
# scripts/provision-execution-plane-token.ps1; never commit the generated value.
EXECUTION_PLANE_TOKEN=__REPLACE_BEFORE_START__

# Bootstrap administrator for Keycloak's master realm. This is not an AEOS user.
KEYCLOAK_ADMIN_USERNAME=__REPLACE_BEFORE_START__
KEYCLOAK_ADMIN_PASSWORD=__REPLACE_BEFORE_START__

# Private PostgreSQL database used only by the Keycloak container.
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=__REPLACE_BEFORE_START__

# Optional personnel administration service client. Keep M01_PERSONNEL_ADMIN_ENABLED=0
# to leave the Hub personnel console disabled. scripts/provision-m01-personnel-admin.ps1
# generates the ignored client secret and writes it here; never commit the .env file.
M01_PERSONNEL_ADMIN_ENABLED=0
M01_PERSONNEL_ADMIN_CLIENT_SECRET=__REPLACE_BEFORE_START__
