# Copy this file to deploy/m01/.env before starting the local M01 identity stack.
# The sentinel values below intentionally pass `docker compose config` but make
# `docker compose up` fail before PostgreSQL or Keycloak starts. Replace each
# sentinel in the copied .env file; never commit that file.

# Caddy exposes Keycloak only on 127.0.0.1:<port>. Keep the hostname as localhost
# unless the Caddyfile and the local development certificate trust are updated too.
M01_KEYCLOAK_HTTPS_PORT=8443
M01_KEYCLOAK_EXTERNAL_HOSTNAME=localhost

# Bootstrap administrator for Keycloak's master realm. This is not an AEOS user.
KEYCLOAK_ADMIN_USERNAME=__REPLACE_BEFORE_START__
KEYCLOAK_ADMIN_PASSWORD=__REPLACE_BEFORE_START__

# Private PostgreSQL database used only by the Keycloak container.
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=__REPLACE_BEFORE_START__
