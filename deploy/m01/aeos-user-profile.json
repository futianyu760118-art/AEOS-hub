{
  "unmanagedAttributePolicy": "ADMIN_EDIT",
  "attributes": [
    {
      "name": "username",
      "displayName": "${username}",
      "permissions": {
        "view": ["admin", "user"],
        "edit": ["admin"]
      }
    },
    {
      "name": "email",
      "displayName": "${email}",
      "permissions": {
        "view": ["admin"],
        "edit": ["admin"]
      },
      "validations": {
        "email": {},
        "length": {
          "max": 320
        }
      }
    },
    {
      "name": "firstName",
      "displayName": "${firstName}",
      "permissions": {
        "view": ["admin"],
        "edit": ["admin"]
      },
      "validations": {
        "length": {
          "max": 320
        }
      }
    },
    {
      "name": "lastName",
      "displayName": "${lastName}",
      "permissions": {
        "view": ["admin"],
        "edit": ["admin"]
      },
      "validations": {
        "length": {
          "max": 320
        }
      }
    },
    {
      "name": "tenant_id",
      "displayName": "租户范围",
