{
  "name": "aeos-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AEOS 中枢 Agent 第一阶段脚手架：codex app-server 编排 + MCP 工具面 + evidence 落库",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "mcp": "node mcp/demo-erp.mjs",
    "test:mcp": "node scripts/test-mcp.mjs",
    "test:harbor": "node --test test/harbor-store.test.ts",
    "test:runtime": "node --test src/runtime/runtime-health.test.ts",
    "test": "npm run test:harbor && npm run test:runtime && npm run test:mcp",
