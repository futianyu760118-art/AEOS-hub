    "web": "node src/server.ts",
    "web:lan": "node src/server.ts --lan",
    "doctor": "codex doctor"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "lucide": "^0.469.0",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@openai/codex": "0.153.0"
  }
}
